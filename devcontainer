#!/usr/bin/env bash
# Devbox container management script
set -euo pipefail

# Configuration
CONTAINER_NAME="${CONTAINER_NAME:-devbox}"
IMAGE_NAME="${IMAGE_NAME:-devbox:latest}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [options]

Commands:
  build           Build the container image
  start           Start the container (build if needed)
  stop            Stop the container
  shell           Open a shell in the running container
  exec <cmd>      Execute a command in the container
  mount <src>     Start container with directory mounted at /workspace
  status          Show container status
  destroy         Remove the container and optionally the image
  rebuild         Force rebuild the image (no cache)
  logs            Show container logs

Options:
  -h, --help      Show this help message

Environment variables:
  CONTAINER_NAME  Container name (default: devbox)
  IMAGE_NAME      Image name (default: devbox:latest)

Examples:
  $(basename "$0") build                    # Build the image
  $(basename "$0") start                    # Start container
  $(basename "$0") mount ~/projects         # Start with ~/projects at /workspace
  $(basename "$0") shell                    # Open shell in container
  $(basename "$0") exec "mise list"         # Run command in container
EOF
}

check_docker() {
    if ! command -v docker &>/dev/null; then
        log_error "Docker is not installed. Please install Docker first."
        exit 1
    fi
    if ! docker info &>/dev/null; then
        log_error "Docker daemon is not running or you don't have permission."
        exit 1
    fi
}

image_exists() {
    docker image inspect "$IMAGE_NAME" &>/dev/null
}

container_exists() {
    docker container inspect "$CONTAINER_NAME" &>/dev/null
}

container_running() {
    [ "$(docker container inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" = "true" ]
}

cmd_build() {
    local cache_flag="${1:-}"
    log_info "Building container image: $IMAGE_NAME"
    cd "$SCRIPT_DIR"

    # Get GITHUB_TOKEN from gh CLI or environment to avoid rate limits
    local github_token="${GITHUB_TOKEN:-}"
    if [ -z "$github_token" ] && command -v gh &>/dev/null; then
        github_token=$(gh auth token 2>/dev/null || true)
    fi

    local build_args=""
    if [ -n "$github_token" ]; then
        build_args="--build-arg GITHUB_TOKEN=${github_token}"
        log_info "Using GitHub token for API requests"
    else
        log_warn "No GitHub token available - may hit rate limits"
    fi

    if [ "$cache_flag" = "--no-cache" ]; then
        # shellcheck disable=SC2086
        docker build --no-cache $build_args -t "$IMAGE_NAME" .
    else
        # shellcheck disable=SC2086
        docker build $build_args -t "$IMAGE_NAME" .
    fi

    log_info "Build complete: $IMAGE_NAME"
}

cmd_start() {
    local mount_src="${1:-}"

    if ! image_exists; then
        log_info "Image not found, building..."
        cmd_build
    fi

    if container_running; then
        log_info "Container '$CONTAINER_NAME' is already running"
        return 0
    fi

    if container_exists; then
        log_info "Starting existing container '$CONTAINER_NAME'"
        docker start "$CONTAINER_NAME"
    else
        log_info "Creating and starting container '$CONTAINER_NAME'"

        local mount_args=""

        # Mount workspace if specified
        if [ -n "$mount_src" ]; then
            mount_args="-v $(realpath "$mount_src"):/workspace"
            log_info "Mounting $mount_src at /workspace"
        fi

        # Mount AI agent config directories from host (for authentication)
        local config_mounts=""

        # Claude Code config directory
        if [ -e "$HOME/.claude" ]; then
            config_mounts="$config_mounts -v $HOME/.claude:/home/ubuntu/.claude"
            log_info "Mounting ~/.claude for Claude Code"
        else
            mkdir -p "$HOME/.claude"
            config_mounts="$config_mounts -v $HOME/.claude:/home/ubuntu/.claude"
        fi

        # Claude Code config file
        if [ -e "$HOME/.claude.json" ]; then
            config_mounts="$config_mounts -v $HOME/.claude.json:/home/ubuntu/.claude.json"
            log_info "Mounting ~/.claude.json for Claude Code auth"
        fi

        # Codex CLI config
        if [ -d "$HOME/.codex" ]; then
            config_mounts="$config_mounts -v $HOME/.codex:/home/ubuntu/.codex"
            log_info "Mounting ~/.codex for Codex auth"
        else
            mkdir -p "$HOME/.codex"
            config_mounts="$config_mounts -v $HOME/.codex:/home/ubuntu/.codex"
        fi

        # Gemini CLI config
        if [ -d "$HOME/.gemini" ]; then
            config_mounts="$config_mounts -v $HOME/.gemini:/home/ubuntu/.gemini"
            log_info "Mounting ~/.gemini for Gemini auth"
        else
            mkdir -p "$HOME/.gemini"
            config_mounts="$config_mounts -v $HOME/.gemini:/home/ubuntu/.gemini"
        fi

        # GitHub CLI config (auth tokens)
        if [ -d "$HOME/.config/gh" ]; then
            config_mounts="$config_mounts -v $HOME/.config/gh:/home/ubuntu/.config/gh:ro"
            log_info "Mounting ~/.config/gh for GitHub CLI auth"
        fi

        # Git config
        if [ -f "$HOME/.gitconfig" ]; then
            config_mounts="$config_mounts -v $HOME/.gitconfig:/home/ubuntu/.gitconfig:ro"
            log_info "Mounting ~/.gitconfig for git config"
        fi

        # SSH keys and config (for git over SSH)
        if [ -d "$HOME/.ssh" ]; then
            config_mounts="$config_mounts -v $HOME/.ssh:/home/ubuntu/.ssh:ro"
            log_info "Mounting ~/.ssh for SSH keys"
        fi

        # Mount Docker socket for Docker-out-of-Docker
        local docker_args=""
        if [ -S "/var/run/docker.sock" ]; then
            docker_args="-v /var/run/docker.sock:/var/run/docker.sock"
            # Get docker group GID from host for socket access
            local docker_gid
            docker_gid=$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo "")
            if [ -n "$docker_gid" ]; then
                docker_args="$docker_args --group-add $docker_gid"
            fi
            log_info "Mounting Docker socket (gid: ${docker_gid:-unknown})"
        fi

        # shellcheck disable=SC2086
        docker run -d \
            --name "$CONTAINER_NAME" \
            --hostname devbox \
            -it \
            $mount_args \
            $config_mounts \
            $docker_args \
            "$IMAGE_NAME" \
            tail -f /dev/null
    fi

    log_info "Container '$CONTAINER_NAME' is running"
}

cmd_stop() {
    if container_running; then
        log_info "Stopping container '$CONTAINER_NAME'"
        docker stop "$CONTAINER_NAME"
    else
        log_warn "Container '$CONTAINER_NAME' is not running"
    fi
}

cmd_shell() {
    if ! container_running; then
        log_info "Container not running, starting..."
        cmd_start
    fi

    log_info "Opening shell in '$CONTAINER_NAME'"
    docker exec -it "$CONTAINER_NAME" /usr/bin/zsh
}

cmd_exec() {
    if [ $# -eq 0 ]; then
        log_error "No command specified"
        echo "Usage: $(basename "$0") exec <command>"
        exit 1
    fi

    if ! container_running; then
        log_info "Container not running, starting..."
        cmd_start
    fi

    docker exec -it "$CONTAINER_NAME" /usr/bin/zsh -c "$*"
}

cmd_mount() {
    if [ $# -eq 0 ]; then
        log_error "No source directory specified"
        echo "Usage: $(basename "$0") mount <source_directory>"
        exit 1
    fi

    local mount_src="$1"

    if [ ! -d "$mount_src" ]; then
        log_error "Directory does not exist: $mount_src"
        exit 1
    fi

    # If container exists, remove it to recreate with mount
    if container_exists; then
        log_info "Removing existing container to add mount..."
        docker rm -f "$CONTAINER_NAME" &>/dev/null || true
    fi

    cmd_start "$mount_src"
}

cmd_status() {
    echo "Container: $CONTAINER_NAME"
    echo "Image: $IMAGE_NAME"
    echo ""

    if image_exists; then
        echo "Image: exists"
        docker images "$IMAGE_NAME" --format "  Created: {{.CreatedSince}}\n  Size: {{.Size}}"
    else
        echo "Image: not built"
    fi
    echo ""

    if container_exists; then
        local state
        state=$(docker container inspect -f '{{.State.Status}}' "$CONTAINER_NAME")
        echo "Container: $state"

        if container_running; then
            # Show mounts
            local mounts
            mounts=$(docker container inspect -f '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{"\n"}}{{end}}' "$CONTAINER_NAME")
            if [ -n "$mounts" ]; then
                echo "Mounts:"
                echo "$mounts" | sed 's/^/  /'
            fi
        fi
    else
        echo "Container: not created"
    fi
}

cmd_destroy() {
    if container_exists; then
        read -rp "Remove container '$CONTAINER_NAME'? [y/N] " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            docker rm -f "$CONTAINER_NAME"
            log_info "Container removed"
        fi
    else
        log_warn "Container '$CONTAINER_NAME' does not exist"
    fi

    if image_exists; then
        read -rp "Remove image '$IMAGE_NAME'? [y/N] " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            docker rmi "$IMAGE_NAME"
            log_info "Image removed"
        fi
    fi
}

cmd_rebuild() {
    log_info "Rebuilding image without cache..."
    cmd_build --no-cache
}

cmd_logs() {
    if ! container_exists; then
        log_error "Container '$CONTAINER_NAME' does not exist"
        exit 1
    fi
    docker logs "$CONTAINER_NAME" "$@"
}

# Main
check_docker

case "${1:-}" in
    build)
        cmd_build
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    shell|sh)
        cmd_shell
        ;;
    exec)
        shift
        cmd_exec "$@"
        ;;
    mount)
        shift
        cmd_mount "$@"
        ;;
    status)
        cmd_status
        ;;
    destroy)
        cmd_destroy
        ;;
    rebuild)
        cmd_rebuild
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        log_error "Unknown command: $1"
        usage
        exit 1
        ;;
esac
