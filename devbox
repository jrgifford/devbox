#!/usr/bin/env bash
set -euo pipefail

# Configuration
VM_NAME="devbox"
VM_CPUS="8"
VM_MEMORY="16G"
VM_DISK="100G"
VM_IMAGE="24.04"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLOUD_INIT_FILE="$SCRIPT_DIR/cloud-init.yaml"
PROVISION_MARKER=".devbox-provisioned"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Load environment variables from .env file or ~/.secrets if they exist
load_env() {
    if [[ -f "$HOME/.secrets" ]]; then
        log_info "Loading environment from ~/.secrets"
        set -a
        source "$HOME/.secrets"
        set +a
    fi
    if [[ -f "$SCRIPT_DIR/.env" ]]; then
        log_info "Loading environment from .env file"
        set -a
        source "$SCRIPT_DIR/.env"
        set +a
    fi
}

# Check if multipass is installed
check_multipass() {
    if ! command -v multipass &> /dev/null; then
        log_error "multipass is not installed. Please install it first:"
        echo "  sudo snap install multipass"
        exit 1
    fi
}

# Check if ansible is installed
check_ansible() {
    if ! command -v ansible-playbook &> /dev/null; then
        log_error "ansible is not installed. Please install it first:"
        echo "  pip install ansible"
        exit 1
    fi
}

# Check if VM exists
vm_exists() {
    multipass list --format csv | grep -q "^$VM_NAME,"
}

# Check if VM is running
vm_running() {
    multipass list --format csv | grep "^$VM_NAME," | grep -q "Running"
}

# Get VM IP address
get_vm_ip() {
    multipass info "$VM_NAME" --format csv | tail -1 | cut -d',' -f3
}

# Wait for cloud-init to complete
wait_for_cloud_init() {
    log_info "Waiting for cloud-init to complete..."
    local max_attempts=60
    local attempt=0

    while [[ $attempt -lt $max_attempts ]]; do
        if multipass exec "$VM_NAME" -- cloud-init status 2>/dev/null | grep -q "done"; then
            log_success "Cloud-init completed"
            return 0
        fi
        attempt=$((attempt + 1))
        echo -n "."
        sleep 5
    done

    echo ""
    log_error "Cloud-init did not complete within expected time"
    return 1
}

# Ensure SSH key exists on host
ensure_ssh_key() {
    if [[ ! -f "$HOME/.ssh/id_ed25519" ]]; then
        log_info "Generating SSH key..."
        mkdir -p "$HOME/.ssh"
        ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519" -N "" -q
        log_success "SSH key generated"
    fi
}

# Setup SSH key in VM for Ansible access
setup_vm_ssh() {
    log_info "Setting up SSH access to VM..."
    local pubkey=$(cat "$HOME/.ssh/id_ed25519.pub")

    # Add host's SSH public key to VM's authorized_keys
    multipass exec "$VM_NAME" -- bash -c "mkdir -p ~/.ssh && chmod 700 ~/.ssh"
    multipass exec "$VM_NAME" -- bash -c "echo '$pubkey' >> ~/.ssh/authorized_keys"
    multipass exec "$VM_NAME" -- bash -c "chmod 600 ~/.ssh/authorized_keys"

    log_success "SSH key added to VM"
}

# Wait for SSH to be available
wait_for_ssh() {
    log_info "Waiting for SSH to be available..."
    local max_attempts=30
    local attempt=0
    local vm_ip=$(get_vm_ip)

    while [[ $attempt -lt $max_attempts ]]; do
        if ssh -o ConnectTimeout=2 -o StrictHostKeyChecking=no -o BatchMode=yes "ubuntu@$vm_ip" true 2>/dev/null; then
            log_success "SSH is available"
            return 0
        fi
        attempt=$((attempt + 1))
        echo -n "."
        sleep 2
    done

    echo ""
    log_error "SSH did not become available within expected time"
    return 1
}

# Generate dynamic inventory
generate_inventory() {
    local vm_ip=$(get_vm_ip)
    cat > "$SCRIPT_DIR/inventory/hosts.ini" << EOF
[devbox]
$vm_ip ansible_user=ubuntu ansible_ssh_common_args='-o StrictHostKeyChecking=no'
EOF
    log_info "Generated inventory with IP: $vm_ip"
}

# Run Ansible provisioning
run_ansible() {
    log_info "Running Ansible provisioning..."

    generate_inventory

    # Export Tailscale auth key for Ansible
    if [[ -n "${TAILSCALE_AUTH_KEY:-}" ]]; then
        export TAILSCALE_AUTH_KEY
    else
        log_warn "TAILSCALE_AUTH_KEY not set - Tailscale will not auto-join"
    fi

    cd "$SCRIPT_DIR"
    ansible-playbook -i inventory/hosts.ini playbooks/site.yml

    log_success "Ansible provisioning completed"
}

# Check if VM is already provisioned
is_provisioned() {
    multipass exec "$VM_NAME" -- test -f "/home/ubuntu/$PROVISION_MARKER" 2>/dev/null
}

# Mark VM as provisioned
mark_provisioned() {
    multipass exec "$VM_NAME" -- touch "/home/ubuntu/$PROVISION_MARKER"
}

# Commands
cmd_start() {
    check_multipass
    check_ansible
    load_env
    ensure_ssh_key

    if vm_exists; then
        if vm_running; then
            log_info "VM '$VM_NAME' is already running"
        else
            log_info "Starting VM '$VM_NAME'..."
            multipass start "$VM_NAME"
            log_success "VM started"
        fi

        # Check if provisioning is needed
        if ! is_provisioned; then
            log_info "VM not provisioned yet, running Ansible..."
            setup_vm_ssh
            wait_for_ssh
            run_ansible
            mark_provisioned
        else
            log_info "VM already provisioned (use './devbox provision' to re-run)"
        fi
    else
        log_info "Creating VM '$VM_NAME'..."
        log_info "  Image: Ubuntu $VM_IMAGE"
        log_info "  CPUs: $VM_CPUS"
        log_info "  Memory: $VM_MEMORY"
        log_info "  Disk: $VM_DISK"

        multipass launch "$VM_IMAGE" \
            --name "$VM_NAME" \
            --cpus "$VM_CPUS" \
            --memory "$VM_MEMORY" \
            --disk "$VM_DISK" \
            --cloud-init "$CLOUD_INIT_FILE"

        log_success "VM created"

        wait_for_cloud_init
        setup_vm_ssh
        wait_for_ssh
        run_ansible
        mark_provisioned

        log_success "VM '$VM_NAME' is ready!"
    fi

    cmd_status
}

cmd_stop() {
    check_multipass

    if ! vm_exists; then
        log_error "VM '$VM_NAME' does not exist"
        exit 1
    fi

    log_info "Stopping VM '$VM_NAME'..."
    multipass stop "$VM_NAME"
    log_success "VM stopped"
}

cmd_login() {
    check_multipass

    if ! vm_exists; then
        log_error "VM '$VM_NAME' does not exist. Run './devbox start' first."
        exit 1
    fi

    if ! vm_running; then
        log_error "VM '$VM_NAME' is not running. Run './devbox start' first."
        exit 1
    fi

    multipass shell "$VM_NAME"
}

cmd_ssh() {
    check_multipass

    if ! vm_exists; then
        log_error "VM '$VM_NAME' does not exist. Run './devbox start' first."
        exit 1
    fi

    if ! vm_running; then
        log_error "VM '$VM_NAME' is not running. Run './devbox start' first."
        exit 1
    fi

    local vm_ip=$(get_vm_ip)
    log_info "Connecting via SSH to ubuntu@$vm_ip..."
    ssh -o StrictHostKeyChecking=no "ubuntu@$vm_ip"
}

cmd_mount() {
    check_multipass

    if [[ $# -lt 2 ]]; then
        log_error "Usage: ./devbox mount <host_path> <vm_path>"
        exit 1
    fi

    local host_path="$1"
    local vm_path="$2"

    if ! vm_exists; then
        log_error "VM '$VM_NAME' does not exist. Run './devbox start' first."
        exit 1
    fi

    if ! vm_running; then
        log_error "VM '$VM_NAME' is not running. Run './devbox start' first."
        exit 1
    fi

    log_info "Mounting $host_path -> $vm_path"
    multipass mount "$host_path" "$VM_NAME:$vm_path"
    log_success "Mount successful"
}

cmd_status() {
    check_multipass

    if ! vm_exists; then
        log_warn "VM '$VM_NAME' does not exist"
        return
    fi

    echo ""
    echo "=== VM Status ==="
    multipass info "$VM_NAME"

    if vm_running; then
        echo ""
        echo "=== Tailscale Status ==="
        multipass exec "$VM_NAME" -- tailscale status 2>/dev/null || echo "Tailscale not configured or not running"
    fi
    echo ""
}

cmd_destroy() {
    check_multipass

    if ! vm_exists; then
        log_warn "VM '$VM_NAME' does not exist"
        return
    fi

    echo -e "${YELLOW}WARNING: This will permanently delete the VM '$VM_NAME' and all its data.${NC}"
    read -p "Are you sure? (yes/no): " confirm

    if [[ "$confirm" != "yes" ]]; then
        log_info "Cancelled"
        return
    fi

    log_info "Destroying VM '$VM_NAME'..."
    multipass delete "$VM_NAME"
    multipass purge
    log_success "VM destroyed"
}

cmd_provision() {
    check_multipass
    check_ansible
    load_env

    if ! vm_exists; then
        log_error "VM '$VM_NAME' does not exist. Run './devbox start' first."
        exit 1
    fi

    if ! vm_running; then
        log_error "VM '$VM_NAME' is not running. Run './devbox start' first."
        exit 1
    fi

    run_ansible
    mark_provisioned
}

cmd_help() {
    echo "Usage: ./devbox <command> [options]"
    echo ""
    echo "Commands:"
    echo "  start              Create VM (if needed) and provision with Ansible"
    echo "  stop               Stop the VM"
    echo "  login              Shell into the VM (multipass shell)"
    echo "  ssh                Direct SSH into the VM"
    echo "  mount <src> <dst>  Mount host directory into VM"
    echo "  status             Show VM info (including Tailscale IP)"
    echo "  destroy            Delete VM (with confirmation)"
    echo "  provision          Re-run Ansible provisioning"
    echo "  help               Show this help message"
    echo ""
    echo "Environment Variables:"
    echo "  TAILSCALE_AUTH_KEY  Tailscale auth key for auto-join (or set in .env file)"
    echo ""
}

# Main
case "${1:-help}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    login)
        cmd_login
        ;;
    ssh)
        cmd_ssh
        ;;
    mount)
        shift
        cmd_mount "$@"
        ;;
    status)
        cmd_status
        ;;
    destroy)
        cmd_destroy
        ;;
    provision)
        cmd_provision
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        log_error "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
